local function buildHeadText(char)
	local head = char:WaitForChild("Head", 5)
	if not head then return end

	local old = head:FindFirstChild("CentryHeadText")
	if old then old:Destroy() end

	local bb = Instance.new("BillboardGui")
	bb.Name = "CentryHeadText"
	bb.Adornee = head
	bb.Size = UDim2.new(0, 280, 0, 60)
	bb.StudsOffset = Vector3.new(0, 3, 0)
	bb.AlwaysOnTop = true
	bb.Parent = head

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Text = HEAD_TEXT
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.Parent = bb

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(110, 0, 12)
	stroke.Thickness = 2
	stroke.Parent = label

	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 30, 50)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 30, 50))})
	grad.Offset = Vector2.new(-1, 0)
	grad.Parent = label
	TweenService:Create(grad, TweenInfo.new(1.5, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1, true), {Offset = Vector2.new(1, 0)}):Play()
end

