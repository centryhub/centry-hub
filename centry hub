updateUI = function()
	if State.confuserOn then
		activateTile.Text = "ON"
		statusLabel.Text = "● ACTIVE"
		statusLabel.TextColor3 = COLORS.accent
	else
		activateTile.Text = "ACTIVATE"
		statusLabel.Text = "● OFF"
		statusLabel.TextColor3 = COLORS.textDim
	end
	setTileOn(activateTile, State.confuserOn)
	local n = tonumber(speedBox.Text) or State.speed
	n = math.max(0, n)
	State.speed = n
end

speedBox.FocusLost:Connect(function()
	TweenService:Create(speedBoxStroke, TweenInfo.new(0.15), {Transparency = 1}):Play()
	local n = tonumber(speedBox.Text)
	if not n then n = State.speed end
	n = math.max(0, n)
	State.speed = n
	speedBox.Text = tostring(n)
	saveConfig()
end)

toggleConfuser = function()
	State.confuserOn = not State.confuserOn
	setConfuser(State.confuserOn)
	updateUI()
	saveConfig()
end

local stealActive = false

local function isCarryingBrainrot()
	local char = LP.Character
	return LP:GetAttribute("Stealing") == true
		or (char ~= nil and char:GetAttribute("Stealing") == true)
end

endSteal = function()
	if not stealActive then return end
	stealActive = false
	State.confuserOn = false
	setConfuser(false)
	updateUI()
end

task.spawn(function()
	while screenGui and screenGui.Parent do
		task.wait(0.15)
		if State.activeOnSteal then
			local carrying = isCarryingBrainrot()
			if carrying and not stealActive and not State.confuserOn then
				stealActive = true
				State.confuserOn = true
				setConfuser(true)
				updateUI()
			elseif not carrying and stealActive then
				endSteal()
			end
		end
	end
end)

track(UserInputService.InputBegan:Connect(function(input, gameProcessed)
	-- Keybind capture from the CONFIG tab
	if listening then
		if input.UserInputType == Enum.UserInputType.Keyboard then
			local k = input.KeyCode
			if k ~= Enum.KeyCode.Escape and k ~= Enum.KeyCode.Unknown then
				if listening == "toggle" and k ~= hideKey then
					toggleKey = k
					saveConfig()
				elseif listening == "hide" and k ~= toggleKey then
					hideKey = k
					saveConfig()
				end
			end
			listening = nil
			refreshKeyButtons()
		end
		return
	end
	if gameProcessed then return end
	if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == hideKey then
		screenGui.Enabled = not screenGui.Enabled
		return
	end
	if input.KeyCode == toggleKey and (input.UserInputType == Enum.UserInputType.Keyboard
		or input.UserInputType == Enum.UserInputType.Gamepad1
		or input.UserInputType == Enum.UserInputType.Gamepad2) then
		toggleConfuser()
	end
end))

-- Dragging
local isDragging = false
local dragInput, mousePos, framePos

mainFrame.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not State.lockGui then
		isDragging = true
		mousePos = input.Position
		framePos = mainFrame.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				isDragging = false
				local pos = mainFrame.Position
				State.guiPos = {XScale = pos.X.Scale, XOffset = pos.X.Offset, YScale = pos.Y.Scale, YOffset = pos.Y.Offset}
				saveConfig()
			end
		end)
	end
end)

mainFrame.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

track(UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and isDragging then
		local delta = input.Position - mousePos
		mainFrame.Position = UDim2.new(framePos.X.Scale, framePos.X.Offset + delta.X, framePos.Y.Scale, framePos.Y.Offset + delta.Y)
	end
end))

